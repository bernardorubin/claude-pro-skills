#!/usr/bin/env bash
# Record, compress and size-check a QA video on macOS.
#
#   qavid page <url> [--steps f.mjs] record the PAGE headlessly (preferred)
#   qavid setup                      check (and offer to install) what's needed
#   qavid record [out.mov] [-s N]    screen recording; ctrl-c stops, -s N caps seconds
#   qavid compress <in> [out.mp4]    shrink under --target MB (default 9)
#   qavid preview <file>             play it so someone can judge the pacing
#   qavid speed <in> <factor>        1.5 = 50% faster, 0.75 = slower
#   qavid gif <in> [out.gif]         short clip as a gif instead
#
# Prefer `page`: Playwright records the browser page only, headless, so the
# terminal and everything else on screen stay out of the video. `record` grabs
# the whole screen and is the fallback for flows a browser can't drive; narrow
# it with --region or --display.
#
# Dependencies: ffmpeg, plus the project's own Playwright for `page`.
#
# ponytail: no config, no state file. The checks are cheap enough to run every
# time, so there is nothing to invalidate.

set -euo pipefail

TARGET_MB=9      # GitHub rejects over 10MB; leave headroom
WIDTH=1280
FPS=15

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { printf '%s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
mb() { echo "scale=1; $(wc -c <"$1") / 1048576" | bc; }

[[ "$(uname -s)" == "Darwin" ]] || die "qavid is macOS only (uses screencapture). On Linux, record with Playwright and use: qavid compress <file>"

# ---------------------------------------------------------------- setup

install_ffmpeg() {
  if have brew; then
    echo "Installing ffmpeg with Homebrew (a few minutes on first run)..."
    brew install ffmpeg
  else
    die "ffmpeg is missing and Homebrew isn't installed.
Install Homebrew first:
  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"
then re-run: qavid setup"
  fi
}

cmd_setup() {
  local ok=0
  if have ffmpeg; then
    echo "ok   ffmpeg $(ffmpeg -version | head -1 | cut -d' ' -f3)"
  else
    echo "MISS ffmpeg"
    install_ffmpeg
    have ffmpeg && echo "ok   ffmpeg installed" || ok=1
  fi

  have screencapture && echo "ok   screencapture (built in)" || { echo "MISS screencapture"; ok=1; }
  have bc && echo "ok   bc (built in)" || { echo "MISS bc"; ok=1; }

  # Screen Recording permission is per-app and silent when missing: the capture
  # writes a file with no frames. A 1-second probe is the only honest check.
  local probe; probe="$(mktemp -t qavid).mov"
  screencapture -x -V 1 "$probe" >/dev/null 2>&1 || true
  if [[ -s "$probe" ]] && ffprobe -v error -select_streams v -count_frames \
      -show_entries stream=nb_read_frames -of csv=p=0 "$probe" 2>/dev/null | grep -qvx "0"; then
    echo "ok   screen recording permission"
  else
    echo "MISS screen recording permission for this terminal app"
    echo "     Grant it: System Settings > Privacy & Security > Screen & System Audio Recording,"
    echo "     enable your terminal (Warp, Terminal, iTerm), then restart the terminal."
    ok=1
  fi
  rm -f "$probe"

  return $ok
}

need_ffmpeg() { have ffmpeg || { echo "ffmpeg missing, running setup first." >&2; cmd_setup >&2; }; }

# ---------------------------------------------------------------- record

cmd_record() {
  local out="" secs="" region="" display=""
  while (($#)); do
    case "$1" in
      -s|--seconds) secs="$2"; shift 2;;
      -R|--region) region="$2"; shift 2;;   # x,y,width,height
      -D|--display) display="$2"; shift 2;;
      *) out="$1"; shift;;
    esac
  done
  out="${out:-$HOME/Desktop/qa-recording-$(date +%m%d-%H%M%S).mov}"
  need_ffmpeg

  # Whole-screen capture puts the terminal, notifications and every other window
  # in the evidence. --region/--display keep them out; `qavid page` avoids the
  # screen entirely and is the better answer when a browser can drive the flow.
  local scope=(); [[ -n "$region" ]] && scope+=(-R "$region"); [[ -n "$display" ]] && scope+=(-D "$display")
  [[ ${#scope[@]} -eq 0 ]] && echo "Capturing the WHOLE screen. Narrow it with --region x,y,w,h or --display N, or use: qavid page <url>" >&2

  if [[ -n "$secs" ]]; then
    echo "Recording for ${secs}s -> $out"
    screencapture -x "${scope[@]}" -V "$secs" "$out"
  else
    echo "Recording -> $out"
    echo "Press ctrl-c here when the flow is done."
    screencapture -x "${scope[@]}" -v "$out" || true   # ctrl-c is the normal exit
  fi

  [[ -s "$out" ]] || die "Nothing was recorded. Run: qavid setup (screen recording permission is the usual cause)."
  echo "Recorded $(mb "$out")MB: $out"
  echo "Next: qavid compress \"$out\""
}

# ---------------------------------------------------------------- page

# Walk up from the working directory for a resolvable playwright. Projects keep
# it in devDependencies, and pnpm hides it behind .pnpm, so check both the plain
# path and the store.
find_playwright_root() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    [[ -d "$dir/node_modules/playwright" ]] && { echo "$dir/node_modules"; return 0; }
    local pnpm_pw; pnpm_pw="$(ls -d "$dir"/node_modules/.pnpm/playwright@*/node_modules 2>/dev/null | head -1 || true)"
    [[ -n "$pnpm_pw" ]] && { echo "$pnpm_pw"; return 0; }
    dir="$(dirname "$dir")"
  done
  return 1
}

# Plenty of projects have no Playwright and shouldn't grow one for a recording —
# a Shopify theme, a Rails app, a static site. Any playwright-core already on the
# machine (playwright-cli installs one) drives system Chrome just as well.
find_global_playwright() {
  local hit
  hit="$(ls -d "$HOME"/Library/pnpm/store/*/links/*/playwright-core/*/*/node_modules/playwright-core 2>/dev/null | sort -V | tail -1 || true)"
  [[ -z "$hit" ]] && hit="$(ls -d "$(npm root -g 2>/dev/null)"/playwright-core 2>/dev/null | head -1 || true)"
  [[ -n "$hit" ]] && { echo "$hit"; return 0; }
  return 1
}

cmd_page() {
  local url="${1:-}"; shift || true
  [[ -n "$url" ]] || die "usage: qavid page <url> [--steps steps.mjs] [--seconds N] [--name flow] [--headed] [--no-cursor]"

  local node_path="" pw_path="" pw_channel=""
  if node_path="$(find_playwright_root)"; then
    :
  elif pw_path="$(find_global_playwright)"; then
    pw_channel="chrome"   # playwright-core ships no browsers; drive installed Chrome
    echo "No Playwright in this project — using the global playwright-core with system Chrome."
  else
    die "No Playwright here and none installed globally.
Add it (pnpm add -D playwright && npx playwright install chromium), or fall back to:
  qavid record --region x,y,w,h"
  fi

  local script="${SELF_DIR}/pw-record.mjs"
  echo "Recording the page headlessly (nothing on your screen is captured)..."
  local webm
  webm="$(PW_MODULE="$node_path" PW_PATH="$pw_path" PW_CHANNEL="$pw_channel" node "$script" --url "$url" "$@" | tail -1)" || true
  [[ -n "$webm" && -f "$webm" ]] || die "No video produced. Run with --headed to watch the flow, or check the steps file."
  echo "Recorded $(mb "$webm")MB: $webm"
  echo "Next: qavid compress \"$webm\""
}

# ---------------------------------------------------------------- compress

cmd_compress() {
  local in="" out="" target="$TARGET_MB" width="$WIDTH" fps="$FPS"
  while (($#)); do
    case "$1" in
      --target) target="$2"; shift 2;;
      --width) width="$2"; shift 2;;
      --fps) fps="$2"; shift 2;;
      *) [[ -z "$in" ]] && in="$1" || out="$1"; shift;;
    esac
  done
  [[ -n "$in" && -f "$in" ]] || die "usage: qavid compress <in> [out.mp4] [--target MB] [--width PX] [--fps N]"
  out="${out:-${in%.*}-qa.mp4}"
  need_ffmpeg

  # Walk the quality ladder until it fits. crf 40 at 960px is already rough, so
  # stop there and say so rather than pretending a smaller file is usable.
  local crf
  for crf in 28 32 36 40; do
    ffmpeg -y -loglevel error -i "$in" \
      -vf "scale=${width}:-2:flags=lanczos,fps=${fps}" \
      -c:v libx264 -preset veryfast -crf "$crf" -pix_fmt yuv420p -movflags +faststart -an \
      "$out"
    local size; size="$(mb "$out")"
    if (( $(echo "$size <= $target" | bc -l) )); then
      echo "Wrote ${size}MB at crf ${crf}, ${width}px, ${fps}fps: $out"
      return 0
    fi
    echo "crf ${crf} gave ${size}MB, over the ${target}MB target; trying harder..." >&2
    [[ "$crf" == 36 ]] && width=960
  done
  echo "Still $(mb "$out")MB after crf 40 at ${width}px: $out" >&2
  echo "Record a shorter clip, or attach it to Jira instead of GitHub." >&2
  return 1
}

# ---------------------------------------------------------------- preview / speed

cmd_preview() {
  local in="${1:-}"
  [[ -n "$in" && -f "$in" ]] || die "usage: qavid preview <file>"
  # QuickTime via `open` rather than a Quick Look panel: it plays, scrubs and
  # loops, which is what someone judging pacing needs.
  open "$in"
  echo "Opened $(mb "$in")MB, $(ffprobe -v error -show_entries format=duration -of csv=p=0 "$in" | cut -d. -f1)s: $in"
}

cmd_speed() {
  local in="${1:-}" factor="${2:-1.5}" out="${3:-}"
  [[ -n "$in" && -f "$in" ]] || die "usage: qavid speed <in> <factor> [out]   (1.5 = 50% faster, 0.75 = slower)"
  out="${out:-${in%.*}-${factor}x.mp4}"
  need_ffmpeg
  # setpts only; there is no audio to keep in sync.
  ffmpeg -y -loglevel error -i "$in" -filter:v "setpts=PTS/${factor}" -c:v libx264 -preset veryfast -crf 28 -pix_fmt yuv420p -movflags +faststart -an "$out"
  echo "Wrote ${factor}x ($(ffprobe -v error -show_entries format=duration -of csv=p=0 "$out" | cut -d. -f1)s, $(mb "$out")MB): $out"
}

# ---------------------------------------------------------------- gif

cmd_gif() {
  local in="${1:-}" out="${2:-}" width=720 fps=12
  [[ -n "$in" && -f "$in" ]] || die "usage: qavid gif <in> [out.gif]"
  out="${out:-${in%.*}.gif}"
  need_ffmpeg
  local pal; pal="$(mktemp -t qavid-pal).png"
  ffmpeg -y -loglevel error -i "$in" -vf "fps=${fps},scale=${width}:-1:flags=lanczos,palettegen" "$pal"
  ffmpeg -y -loglevel error -i "$in" -i "$pal" \
    -lavfi "fps=${fps},scale=${width}:-1:flags=lanczos[x];[x][1:v]paletteuse" "$out"
  rm -f "$pal"
  echo "Wrote $(mb "$out")MB: $out"
  echo "A gif is 5-10x the bytes of the same mp4 — keep it under ~10s."
}

# ---------------------------------------------------------------- main

case "${1:-}" in
  page) shift; cmd_page "$@";;
  setup) shift; cmd_setup;;
  record) shift; cmd_record "$@";;
  compress) shift; cmd_compress "$@";;
  preview) shift; cmd_preview "$@";;
  speed) shift; cmd_speed "$@";;
  gif) shift; cmd_gif "$@";;
  ""|-h|--help)
    sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//';;
  *) die "unknown command: $1 (try: setup, record, compress, gif)";;
esac
